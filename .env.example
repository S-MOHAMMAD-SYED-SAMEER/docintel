# Copy to .env and fill in. Never commit .env.

# --- App ---
DOCINTEL_ENVIRONMENT=local
DOCINTEL_DEBUG=true

# --- Storage ---
# Where uploaded documents and rendered page images are written (milestone 3).
DOCINTEL_STORAGE_DIR=./var/storage

# --- Database ---
DOCINTEL_DATABASE_URL=postgresql+psycopg://docintel:docintel@localhost:5432/docintel

# Used only by the test suite, which migrates and tears this database down on
# every run — never point it at the database above. Tests that need it are
# skipped when no server answers.
DOCINTEL_TEST_DATABASE_URL=postgresql+psycopg://docintel:docintel@localhost:5432/docintel_test

# --- Extraction provider (wired in milestone 4) ---
DOCINTEL_ANTHROPIC_API_KEY=
DOCINTEL_EXTRACTION_MODEL=claude-sonnet-5

# --- Review routing (wired in milestone 5) ---
# Any field scoring below this goes to the human review queue.
DOCINTEL_CONFIDENCE_THRESHOLD=0.85
