# Copy to .env and fill in. Never commit .env (it is gitignored).
#
# Every value below is a LOCAL DEVELOPMENT default. Before running this
# anywhere else, at minimum:
#   - point DOCINTEL_DATABASE_URL at a real database with a real credential
#   - set DOCINTEL_DEBUG=false
#   - supply DOCINTEL_ANTHROPIC_API_KEY from your secret store, not from a file
# No real credential is committed in this repository.

# --- App ---
DOCINTEL_ENVIRONMENT=local
# Leave false outside development: it enables FastAPI's debug behaviour.
DOCINTEL_DEBUG=false

# --- Storage and rendering ---
# Root for uploaded documents and their rendered page images.
DOCINTEL_STORAGE_DIR=./var/storage
# Uploads larger than this are rejected with 413. Default 25 MiB.
DOCINTEL_MAX_UPLOAD_BYTES=26214400
# Resolution for rendered PDF pages (72-600).
DOCINTEL_RENDER_DPI=200

# --- Database ---
DOCINTEL_DATABASE_URL=postgresql+psycopg://docintel:docintel@localhost:5432/docintel

# Used only by the test suite, which migrates and tears this database down on
# every run — never point it at the database above. Tests that need it are
# skipped when no server answers.
DOCINTEL_TEST_DATABASE_URL=postgresql+psycopg://docintel:docintel@localhost:5432/docintel_test

# --- Extraction provider ---
# Leave blank to fall back to the SDK's own ANTHROPIC_API_KEY / profile lookup.
DOCINTEL_ANTHROPIC_API_KEY=
DOCINTEL_EXTRACTION_MODEL=claude-haiku-4-5
# Ceiling for one extraction response.
DOCINTEL_EXTRACTION_MAX_TOKENS=16000
# How the Anthropic adapter treats a slow or failing service (all optional; these are the defaults).
# A request is cut off after this many seconds:
# DOCINTEL_EXTRACTION_TIMEOUT_SECONDS=120
# A transient failure (timeout, connection error, 408/409/429, 5xx) is retried this many more times; 0 = never.
# DOCINTEL_EXTRACTION_MAX_RETRIES=2
# A document over this many pages, or whose pages exceed this many bytes together, is refused before any model call.
# DOCINTEL_MAX_PAGES=20
# DOCINTEL_MAX_IMAGE_BYTES_TOTAL=20971520
# USD per million tokens, to add or correct a price: {"<model id>": [input, output]}. No entry = no cost recorded.
# DOCINTEL_PRICING_USD_PER_MTOK={}

# --- Confidence scoring and review routing ---
# Any field scoring below this goes to the human review queue.
DOCINTEL_CONFIDENCE_THRESHOLD=0.85
# Weights for the four confidence signals. They need not sum to 1: only the
# signals that apply to a field are used, and their weights are renormalised
# over that subset. The model's own opinion gets less than half the say.
DOCINTEL_CONFIDENCE_WEIGHT_MODEL=0.40
DOCINTEL_CONFIDENCE_WEIGHT_SCHEMA=0.20
DOCINTEL_CONFIDENCE_WEIGHT_ARITHMETIC=0.20
DOCINTEL_CONFIDENCE_WEIGHT_TEXT_LAYER=0.20
